// /api/visit.js - V7 VISITOR TRACKER
let visitsData={ total:0, today:0, todayDate:new Date().toISOString().split('T')[0], daily:{}, lastVisits:[] };
function getTodayWAT(){ return new Date().toLocaleDateString('en-CA',{timeZone:'Africa/Lagos'}); }
export default async function handler(req,res){
  const today=getTodayWAT();
  if(visitsData.todayDate!==today){ visitsData.today=0; visitsData.todayDate=today; }
  if(req.method==='POST'){
    const ip=req.headers['x-forwarded-for']?.split(',')[0]||req.headers['x-real-ip']||'unknown';
    const page=req.body?.page||req.query?.page||'/';
    visitsData.total+=1; visitsData.today+=1;
    if(!visitsData.daily[today]) visitsData.daily[today]=0; visitsData.daily[today]+=1;
    const now=Date.now();
    const last=visitsData.lastVisits.find(v=>v.ip===ip && (now-v.timestamp)<5*60*1000);
    if(!last){ visitsData.lastVisits.unshift({ip:ip.substring(0,20),time:new Date().toLocaleString('en-GB',{timeZone:'Africa/Lagos'}),date:today,page,timestamp:now}); if(visitsData.lastVisits.length>50) visitsData.lastVisits=visitsData.lastVisits.slice(0,50); }
    res.setHeader('Cache-Control','no-store'); return res.json({success:true,total:visitsData.total,today:visitsData.today,todayDate:today,daily:visitsData.daily});
  }
  if(req.method==='GET'){ res.setHeader('Cache-Control','no-store'); return res.json({total:visitsData.total,today:visitsData.today,todayDate:visitsData.todayDate,daily:visitsData.daily,lastVisits:visitsData.lastVisits.slice(0,20),last7Days:Object.entries(visitsData.daily).sort().slice(-7)}); }
  res.status(405).json({error:'Method not allowed'});
}